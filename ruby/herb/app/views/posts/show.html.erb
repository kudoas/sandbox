<% content_for :title, @post.title %>

<article class="rounded-[1.75rem] border border-stone-900/10 bg-white/70 p-8 shadow-[0_18px_50px_rgba(63,43,20,0.08)]">
  <p class="mb-3 text-xs font-bold tracking-[0.24em] text-orange-700 uppercase">Article</p>
  <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"><%= @post.title %></h1>

  <p class="mt-4 text-sm text-stone-500 sm:text-base">
    公開日 <%= l(@post.created_at.to_date, format: :long) %> · 更新 <%= l(@post.updated_at, format: :short) %>
  </p>

  <div class="mt-8 space-y-6 text-lg leading-8 text-stone-700 [&_p]:mb-6">
    <%= simple_format(@post.body) %>
  </div>
</article>

<section class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
  <%= link_to "編集する", edit_post_path(@post), class: "inline-flex min-h-11 items-center justify-center rounded-full bg-orange-700 px-5 text-sm font-medium text-orange-50 transition hover:bg-orange-800" %>
  <%= link_to "一覧へ戻る", posts_path, class: "inline-flex min-h-11 items-center justify-center rounded-full border border-stone-900/10 bg-white/40 px-5 text-sm font-medium text-stone-800 transition hover:bg-white/70" %>
  <%= button_to "削除する", @post, method: :delete, class: "inline-flex min-h-11 items-center justify-center rounded-full bg-red-800 px-5 text-sm font-medium text-white transition hover:bg-red-900" %>
</section>
