<% content_for :title, "新規投稿" %>

<section class="m-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <p class="mb-2 text-xs font-bold tracking-[0.24em] text-orange-700 uppercase">New Post</p>

    <%= tag.div class: ["text-4xl", "font-semibold", "uppercase", "tracking-tight"] do %>
      記事を書く
    <% end %>

    <%= tag.div "記事を書く", class: ["text-4xl", "font-semibold", "uppercase", "tracking-tight"] %>

    <div class="text-4xl font-semibold tracking-tight uppercase">記事を書く</div>

    <h1 class="text-4xl font-semibold tracking-tight">記事を書く</h1>
  </div>

  <%= link_to "一覧へ戻る", posts_path, class: "inline-flex min-h-11 items-center justify-center rounded-full border border-stone-900/10 bg-white/40 px-5 text-sm font-medium text-stone-800 transition hover:bg-white/70" %>
</section>

<%= render "form", post: @post %>
