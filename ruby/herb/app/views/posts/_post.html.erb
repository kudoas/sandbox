<article id="<%= dom_id post %>" class="rounded-[1.5rem] border border-stone-900/10 bg-white/70 p-6 shadow-[0_18px_50px_rgba(63,43,20,0.08)]">
  <p class="text-sm text-stone-500"><%= l(post.created_at.to_date, format: :long) %></p>
  <h2 class="mt-3 text-2xl font-semibold"><%= post.title %></h2>
  <p class="mt-3 text-stone-600"><%= post.excerpt %></p>
</article>
